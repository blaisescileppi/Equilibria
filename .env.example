# Copy this file to .env and fill in your own values. .env is git-ignored.

# Database the app uses in development.
# Homebrew Postgres on macOS uses your macOS username and no password:
#   postgresql://YOUR_MAC_USERNAME@localhost:5432/equilibria_dev
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/equilibria_dev"

# Database the test suite uses. Tests delete all rows in it, so never point
# this at a database you care about.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/equilibria_test"
