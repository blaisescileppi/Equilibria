// Equilibria data model. See README.md ("Schema overview") for a diagram.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Accounts ----------

model User {
  id           String   @id @default(cuid())
  email        String   @unique // stored lowercase
  passwordHash String
  displayName  String // shown on meal posts
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions    Session[]
  cycles      Cycle[]
  dailyLogs   DailyLog[]
  customFoods Food[]
  mealEntries MealEntry[]
  posts       MealPost[]
  likes       PostLike[]
  favorites   PostFavorite[]
}

// The cookie holds a random token; only its SHA-256 hash is stored here,
// so a leaked database row can't be replayed as a login cookie.
model Session {
  id        String   @id // SHA-256 hex of the session token
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Cycle tracking ----------

// One period. Cycle length is derived from the gap between consecutive
// start dates, so it isn't stored.
model Cycle {
  id        String    @id @default(cuid())
  userId    String
  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date // null while the period is ongoing
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, startDate])
}

enum Mood {
  GREAT
  GOOD
  OKAY
  LOW
  BAD
}

enum Symptom {
  CRAMPS
  BLOATING
  HEADACHE
  ACNE
  FATIGUE
  BREAST_TENDERNESS
  BACK_PAIN
  NAUSEA
  CRAVINGS
  INSOMNIA
  MOOD_SWINGS
  ANXIETY
}

model DailyLog {
  id        String    @id @default(cuid())
  userId    String
  date      DateTime  @db.Date
  mood      Mood
  symptoms  Symptom[]
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date]) // one log per day
}

// ---------- Meal tracking ----------

// Nutrient values are per serving. createdById is null for the built-in
// library (seeded from USDA data) and set for a user's custom foods.
model Food {
  id          String  @id @default(cuid())
  name        String
  servingSize Float
  servingUnit String
  createdById String?

  calories Float
  proteinG Float
  carbsG   Float
  fatG     Float
  fiberG   Float
  sugarG   Float

  ironMg        Float
  calciumMg     Float
  folateMcg     Float
  vitaminDMcg   Float
  vitaminB12Mcg Float
  magnesiumMg   Float
  zincMg        Float
  potassiumMg   Float
  sodiumMg      Float
  vitaminCMg    Float

  createdAt DateTime    @default(now())
  createdBy User?       @relation(fields: [createdById], references: [id], onDelete: Cascade)
  entries   MealEntry[]

  @@index([createdById])
  @@index([name])
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model MealEntry {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  mealType  MealType
  foodId    String
  servings  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // A food can't be deleted while logged meals still use it, otherwise past
  // nutrient totals would silently change. NoAction (not Restrict) because
  // Postgres checks it at the end of the statement, so deleting a user can
  // still cascade through their meal entries and custom foods together.
  food      Food     @relation(fields: [foodId], references: [id], onDelete: NoAction)

  @@index([userId, date])
}

// ---------- Meal suggestions board ----------

enum MealTag {
  HIGH_PROTEIN
  IRON_RICH
  HIGH_FIBER
  VEGETARIAN
  VEGAN
  GLUTEN_FREE
  DAIRY_FREE
  LOW_SUGAR
  QUICK
  BUDGET
}

model MealPost {
  id           String         @id @default(cuid())
  authorId     String
  title        String
  description  String
  ingredients  String // one ingredient per line
  instructions String?
  tags         MealTag[]
  imageKey     String? // file name in the upload store
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  author       User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes        PostLike[]
  favorites    PostFavorite[]

  @@index([createdAt])
}

// Composite primary keys make "like twice" impossible at the database level.
model PostLike {
  userId    String
  postId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      MealPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
}

model PostFavorite {
  userId    String
  postId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      MealPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
}
